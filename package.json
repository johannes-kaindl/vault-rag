{
  "name": "vault-retrieval",
  "version": "0.20.0",
  "description": "On-device retrieval over your vault — related notes, semantic search — plus grounded chat with the LLM endpoint you configure.",
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "rag",
    "embeddings",
    "semantic-search",
    "related-notes",
    "offline",
    "local-first"
  ],
  "type": "module",
  "scripts": {
    "build": "node esbuild.config.mjs production",
    "dev": "node esbuild.config.mjs",
    "test": "node scripts/check-no-abs-paths.mjs && node scripts/check-no-nul-bytes.mjs && vitest run",
    "lint": "eslint src --max-warnings 0",
    "gate": "npm run typecheck && npm test && npm run lint && npm run build",
    "typecheck": "tsc --noEmit",
    "version-bump": "node scripts/version-bump.mjs",
    "release": "node scripts/release.mjs",
    "smoke:gui": "esbuild scripts/gui-smoke.ts --bundle --platform=node --format=esm --outfile=.gui-smoke.mjs --log-level=warning && node .gui-smoke.mjs"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@types/node": "^26.1.1",
    "esbuild": "^0.21.0",
    "eslint": "^9.39.4",
    "eslint-plugin-obsidianmd": "^0.4.1",
    "happy-dom": "^14.0.0",
    "obsidian": "^1.13.0",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.61.1",
    "vitest": "^1.6.0",
    "zod": "^4.4.3"
  }
}
